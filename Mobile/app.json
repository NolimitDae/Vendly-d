{
  "expo": {
    "name": "Vendly",
    "slug": "vendly",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3E6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vendly.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14061A"
      },
      "package": "com.vendly.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 9
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Vendly needs access to your photos to upload listing images and profile pictures.",
          "cameraPermission": "Vendly needs access to your camera to take photos for listings and your profile."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.vendly",
          "enableGooglePay": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vendly uses your location to show vendors and services near you, and to stamp proof-of-work photos with where they were taken so your work is protected if a booking is disputed."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "490325e9-37a3-424d-9247-cad34e99e35e"
      }
    },
    "owner": "nolimittechs-organization",
    "scheme": "vendly",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/490325e9-37a3-424d-9247-cad34e99e35e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}

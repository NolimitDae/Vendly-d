APP_NAME=Vendly
APP_KEY=change-me-to-a-random-32-char-string
PORT=4000
APP_URL=https://your-api-domain.com

CLIENT_APP_URL=https://your-frontend-domain.com
# Extra website addresses allowed to call the API (comma-separated), e.g. the old Railway URL during a domain move
# CORS_ORIGINS=https://www.your-frontend-domain.com,https://your-app.up.railway.app
SESSION_SECRET=change-me-to-a-random-secret
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

DATABASE_URL="postgresql://user:password@localhost:5432/vendly_production"

REDIS_HOST=your-redis-host
REDIS_PASSWORD=your-redis-password
REDIS_PORT=6379

MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (register at https://console.cloud.google.com)
GOOGLE_APP_ID=your-google-client-id
GOOGLE_APP_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=${APP_URL}/api/auth/google/redirect
# App sign-in (POST /auth/social): every Google OAuth client ID the apps use (web, iOS, Android), comma-separated
GOOGLE_CLIENT_IDS=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com
# Sign in with Apple: the iOS bundle id (plus a web Services ID if you add one)
APPLE_CLIENT_IDS=com.vendly.mobile

# Facebook OAuth (register at https://developers.facebook.com)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=${APP_URL}/api/auth/facebook/redirect

# File storage — choose one driver and fill its section
# Local storage (dev only):
# Uploads: local disk unless STORAGE_DRIVER=s3. Production uses Cloudflare R2:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=vendly-public              (listing photos, avatars, proof photos)
# S3_PRIVATE_BUCKET=vendly-private     (contracts, signatures, event files; never public)
# S3_ACCESS_KEY_ID=...                 (R2 API token: Object Read & Write on both buckets)
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev  (or your custom media domain)
# The AWS_* names below are older fallbacks for the same settings.
# AWS_ENDPOINT=http://localhost:9000  (for MinIO)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=vendly-uploads
AWS_URL=https://your-bucket.s3.amazonaws.com
AWS_ENDPOINT=https://s3.amazonaws.com

GCP_PROJECT_ID=
GCP_KEY_FILE=
GCP_API_ENDPOINT=
GCP_BUCKET=

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Vendly Protection fee charged to whoever books: percent of the vendor price, with a minimum (dollars)
CUSTOMER_SERVICE_FEE_PERCENT=5
CUSTOMER_SERVICE_FEE_MINIMUM=3

# Stripe subscription price IDs (get from https://dashboard.stripe.com/products)
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELITE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELITE_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxxxxxxxxxxxxxxxxxx

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=

# Default admin account — CHANGE BEFORE DEPLOY
SYSTEM_USERNAME=admin
SYSTEM_EMAIL=admin@your-domain.com
SYSTEM_PASSWORD=use-a-strong-password-here

# Error tracking (Sentry). Leave empty to turn it off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Product analytics (PostHog project API key). Leave empty to turn it off.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# "Near me" search: contact email sent to the OpenStreetMap geocoder (their usage policy)
GEOCODER_CONTACT_EMAIL=support@vendly.app
# Only when uploads stay on local disk: point these at a persistent volume (not needed with R2)
STORAGE_DIR=/data/storage
# Uploaded files that must stay private (contracts, signatures, event files). Point at a persistent volume on Railway.
PRIVATE_STORAGE_DIR=/data/private

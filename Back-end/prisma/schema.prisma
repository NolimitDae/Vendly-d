generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------
 * --- Enum Start ---
 * -------------------------------------------------------------
 */

enum UserType {
  ADMIN
  CUSTOMER
  VENDOR
  EVENT_PLANNER
  PROVIDER
  EDITOR
  CLIENT
}

enum ADMIN_APPROVE_STATUS {
  PENDING
  APPROVED
  NOT_APPLICABLE
  SUSPENDED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  PENDING
}

enum WorkingType {
  DAY
  HOUR
}

enum OperatedBy {
  REMOTE
  ON_SITE
  HYBRID
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum SubscriptionBillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  CONCERT
  CONFERENCE
  PRIVATE_PARTY
  OTHER
}

enum EventStatus {
  PLANNING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/**
 * ------------------------------------------------------------
 * --- Enum End ---
 * -------------------------------------------------------------
 */

model Account {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type                String?
  provider            String?
  provider_account_id String?
  refresh_token       String?
  access_token        String?
  expires_at          DateTime?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?

  @@unique([provider, provider_account_id])
  @@map("accounts")
}

/**
 * ------------------------------------------------------------
 * --- user profile part start ---
 * -------------------------------------------------------------
 */

model User {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?
  status     Int?      @default(1) @db.SmallInt

  first_name   String? @db.VarChar(255)
  last_name    String? @db.VarChar(255)
  name         String? @db.VarChar(255)
  avatar       String?
  location     String? @db.VarChar(255)
  phone_number String?
  email        String? @unique
  password     String? @db.VarChar(255)
  birthday     String?

  about_me String?
  address  String?
  type     UserType? @default(CUSTOMER)
  language String?   @db.VarChar(100)

  // billing info  
  billing_id        String?
  // stripe connect account
  stripe_connect_id String?
  //user balance
  balance           Decimal?  @default(0.0) @db.Decimal(10, 2)
  // expo push notifications
  push_token        String?
  // email verification
  email_verified_at DateTime?
  // subscription 

  //----------------------------------------
  bio           String?   @db.Text
  domain        String?   @unique
  username      String?   @unique
  country       String?
  state         String?
  city          String?
  zip_code      String?
  gender        String?
  date_of_birth DateTime? @db.Date
  approved_at   DateTime?
  availability  String?

  is_two_factor_enabled Int?      @default(0)
  two_factor_secret     String?
  accounts              Account[]

  // --- Vendor Profile ---
  vendorProfile VendorProfile? @relation("UserToVendorProfile")

  // --- Conversation & Messaging ---
  participants Participant[] @relation("participantUser")
  sentMessages Message[]     @relation("messageSender")

  // --- Notifications ---
  receivedNotifications Notification[] @relation("notificationReceiver")
  sentNotifications     Notification[] @relation("notificationSender")

  user_payment_methods UserPaymentMethod[]
  ucodes               Ucode[]
  role_users           RoleUser[]
  payment_transactions PaymentTransaction[]

  // Vendor listings
  vendorListings VendorListing[] @relation("VendorListingOwner")

  // Bookings as customer
  customerBookings Booking[] @relation("BookingCustomer")
  // Bookings as vendor
  vendorBookings Booking[] @relation("BookingVendor")
  // Proof uploads
  bookingProofs BookingProof[] @relation("ProofUploader")
  // Deliverables sent
  deliverables  BookingDeliverable[] @relation("DeliverableVendor")

  vendorContracts     VendorContract[]     @relation("VendorContractOwner")
  contractSignatures  ContractSignature[]  @relation("ContractSigner")
  contractAuditEvents ContractAuditEvent[] @relation("ContractAuditActor")
  // anonymised instead of deleted when the user is party to an executed contract
  anonymized_at       DateTime?

  // Events as planner
  plannedEvents Event[] @relation("EventPlannerEvents")

  // Reviews
  writtenReviews  Review[] @relation("ReviewAuthor")
  receivedReviews Review[] @relation("ReviewVendor")

  // Saved listings (favourites)
  savedListings SavedListing[] @relation("UserSavedListings")

  // Event planner profile
  eventPlannerProfile EventPlannerProfile? @relation("UserToEventPlannerProfile")

  @@map("users")
}

model VendorProfile {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String @unique
  user    User   @relation("UserToVendorProfile", fields: [user_id], references: [id], onDelete: Cascade)

  subscription_active Boolean              @default(false)
  // license
  license_photo       String[]
  license_status      ADMIN_APPROVE_STATUS @default(PENDING)
  approved_at         DateTime?

  // business info
  business_name           String?                  @db.VarChar(255)
  about_me                String?                  @db.Text
  address                 String?
  vendorSubscriptionPlans VendorSubscriptionPlan[]
  // private storage key of the vendor's saved drawn signature
  saved_signature_key     String?

  @@map("vendor_profiles")
}

model Ucode {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  status     Int?     @default(1) @db.SmallInt

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  token       String?
  email       String?
  expired_at  DateTime?
  verified_at DateTime?

  @@map("ucodes")
}

/**
 * ------------------------------------------------------------
 * --- user profile part end ---
 * -------------------------------------------------------------
 */
/**
 * ------------------------------------------------------------
 * --- Subscription part start ---
 * -------------------------------------------------------------
 */

model Subscriptionlist {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  name String

  billing_cycle           SubscriptionBillingCycle?
  status                  SubscriptionStatus?
  vendorSubscriptionPlans VendorSubscriptionPlan[]

  @@map("subscriptions")
}

model VendorSubscriptionPlan {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  vendor_id String
  vendor    VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  subscription_id String
  subscription    Subscriptionlist @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  start_date DateTime?
  end_date   DateTime?

  payment_status         SubscriptionPaymentStatus?
  stripe_subscription_id String?

  @@map("vendor_subscriptions")
}

/**
 * ------------------------------------------------------------
 * --- Subscription part end---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- service part start ---
 * -------------------------------------------------------------
 */

model Service {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name         String      @db.VarChar(255)
  operated_by  OperatedBy
  working_type WorkingType
  commission   Decimal     @default(0.0) @db.Decimal(5, 2)

  // Relationships  ক্যাটেগরি সম্পর্ক
  category_id String
  category    ServiceCategory @relation("ServiceCategoryRelation", fields: [category_id], references: [id])

  // Many-to-Many relationship with serviceToSubCategory
  sub_categories ServiceToSubCategory[] @relation("ServiceWithManyToMany")

  @@map("services")
}

model ServiceCategory {
  id         String   @id @default(cuid())
  name       String   @unique @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relationships with  service
  services       Service[]            @relation("ServiceCategoryRelation")
  // Many-to-Many relationship with sub-categories
  sub_categories ServiceSubCategory[] @relation("ServiceCategoryToSubCategory")
  // Vendor listings
  vendor_listings VendorListing[]

  @@map("service_categories")
}

model ServiceSubCategory {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String @db.VarChar(255)

  // Parent Category link
  category_id String
  category    ServiceCategory @relation("ServiceCategoryToSubCategory", fields: [category_id], references: [id], onDelete: Cascade)

  // Many-to-Many join table link
  services ServiceToSubCategory[] @relation("Subcatagoryto-ServiceToSubCategory")
  // Vendor listings
  vendor_listings VendorListing[]

  @@unique([name, category_id])
  @@map("service_sub_categories")
}

// between Service and ServiceSubCategory
model ServiceToSubCategory {
  service_id      String
  sub_category_id String

  service      Service            @relation("ServiceWithManyToMany", fields: [service_id], references: [id], onDelete: Cascade)
  sub_category ServiceSubCategory @relation("Subcatagoryto-ServiceToSubCategory", fields: [sub_category_id], references: [id], onDelete: Cascade)

  @@id([service_id, sub_category_id])
  @@map("service_to_sub_categories")
}

/**
 * ------------------------------------------------------------
 * --- service part end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Chating Part Start ---
 * -------------------------------------------------------------
 */

model Conversation {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  participants Participant[]
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("participantUser", fields: [userId], references: [id], onDelete: Cascade)

  role     String?  @default("participant")
  joinedAt DateTime @default(now())

  lastReadAt DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id        String   @id @default(cuid())
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status MessageStatus @default(PENDING)

  senderId String
  sender   User   @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  attachments String[] @db.Text

  @@index([conversationId])
  @@index([senderId])
}

/**
 * ------------------------------------------------------------
 * --- Chating Part End ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Notification Part Start ---
 * -------------------------------------------------------------
 */

model NotificationEvent {
  id            String         @id @default(uuid())
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  deleted_at    DateTime?
  status        Int?           @default(1) @db.SmallInt
  type          String?
  text          String?
  notifications Notification[]
}

model Notification {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?
  read_at    DateTime?
  status     Int?      @default(1) @db.SmallInt

  sender_id String?
  sender    User?   @relation("notificationSender", fields: [sender_id], references: [id])

  receiver_id String?
  receiver    User?   @relation("notificationReceiver", fields: [receiver_id], references: [id])

  notification_event_id String?
  notification_event    NotificationEvent? @relation(fields: [notification_event_id], references: [id])

  entity_id String?

  @@index([receiver_id])
  @@index([sender_id])
  @@index([read_at])
}

/**
 * ------------------------------------------------------------
 * --- Notification Part End ---
 * -------------------------------------------------------------
 */
/**
 * ------------------------------------------------------------
 * --- Role and Permission Schema start ---
 * -------------------------------------------------------------
 */

model Role {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status Int?    @default(1) @db.SmallInt
  title  String?
  name   String?

  permission_roles PermissionRole[]
  role_users       RoleUser[]
  permissions      Permission[]     @relation("PermissionToRole")

  @@map("roles")
}

model Permission {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status     Int?    @default(1) @db.SmallInt
  title      String?
  action     String?
  subject    String?
  conditions String?
  fields     String?

  permission_roles PermissionRole[]
  roles            Role[]           @relation("PermissionToRole")

  @@map("permissions")
}

model PermissionRole {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([permission_id, role_id])
  @@map("permission_roles")
}

model RoleUser {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([role_id, user_id])
  @@map("role_users")
}

/**
 * ------------------------------------------------------------
 * --- Role and Permission Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Payment Schema start ---
 * -------------------------------------------------------------
 */

model UserPaymentMethod {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  payment_method_id String?
  checkout_id       String?

  @@map("user_payment_methods")
}

model PaymentTransaction {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  store_id String?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  order_id         String?
  type             String?  @default("order")
  withdraw_via     String?  @default("wallet")
  provider         String?
  reference_number String?
  status           String?  @default("pending")
  raw_status       String?
  amount           Decimal?
  currency         String?
  paid_amount      Decimal?
  paid_currency    String?

  @@map("payment_transactions")
}

/**
 * ------------------------------------------------------------
 * --- Payment Schema end ---
 * -------------------------------------------------------------
 */
/**
 * ------------------------------------------------------------
 * --- Vendor Listing Schema start ---
 * -------------------------------------------------------------
 */

model VendorListing {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  vendor_id String
  vendor    User   @relation("VendorListingOwner", fields: [vendor_id], references: [id], onDelete: Cascade)

  title       String        @db.VarChar(255)
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  price_unit  String        @default("fixed") @db.VarChar(50)
  status      ListingStatus @default(DRAFT)

  images        String[]
  tags          String[]
  location      String?   @db.VarChar(255)
  availability  String?   @db.Text
  delivery_time Int?

  category_id    String?
  category       ServiceCategory?    @relation(fields: [category_id], references: [id])
  sub_category_id String?
  sub_category   ServiceSubCategory? @relation(fields: [sub_category_id], references: [id])

  bookings       Booking[]
  reviews        Review[]
  savedBy        SavedListing[]        @relation("ListingSavedBy")
  blockedDates   ListingAvailability[]
  contractAssignments VendorContractListing[]

  @@map("vendor_listings")
}

model ListingAvailability {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  listing_id String
  listing    VendorListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  reason     String?  @db.VarChar(255)

  @@map("listing_availability")
}

/**
 * ------------------------------------------------------------
 * --- Vendor Listing Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Saved Listings (Favourites) ---
 * -------------------------------------------------------------
 */

model SavedListing {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  user_id String
  user    User   @relation("UserSavedListings", fields: [user_id], references: [id], onDelete: Cascade)

  listing_id String
  listing    VendorListing @relation("ListingSavedBy", fields: [listing_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id])
  @@map("saved_listings")
}

/**
 * ------------------------------------------------------------
 * --- Saved Listings end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Booking Schema start ---
 * -------------------------------------------------------------
 */

model Booking {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  customer_id String
  customer    User   @relation("BookingCustomer", fields: [customer_id], references: [id], onDelete: Cascade)

  vendor_id String
  vendor    User   @relation("BookingVendor", fields: [vendor_id], references: [id], onDelete: Cascade)

  listing_id String?
  listing    VendorListing? @relation(fields: [listing_id], references: [id])

  status        BookingStatus @default(PENDING)
  scheduled_at  DateTime?
  completed_at  DateTime?
  cancelled_at  DateTime?

  message        String?  @db.Text
  reject_reason  String?  @db.Text
  cancel_reason  String?  @db.Text

  amount         Decimal? @db.Decimal(10, 2)
  currency       String?  @default("usd")
  // Vendly's customer service fee, fixed when the booking is requested
  service_fee    Decimal? @db.Decimal(10, 2)
  paid_at            DateTime?
  // vendor earnings credited to their payout balance (set once, on completion)
  payout_credited_at DateTime?

  payment_transaction_id String?

  event_start_at DateTime?
  event_end_at   DateTime?
  venue_address  String?  @db.VarChar(500)
  guest_count    Int?

  review        Review?
  contracts     BookingContract[]
  event_bookings EventBooking[]
  proofs        BookingProof[]
  deliverables  BookingDeliverable[]

  @@map("bookings")
}

model BookingProof {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  uploader_id String
  uploader    User   @relation("ProofUploader", fields: [uploader_id], references: [id])

  photos      String[]
  notes       String?  @db.Text

  @@map("booking_proofs")
}

model BookingDeliverable {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  vendor_id String
  vendor    User   @relation("DeliverableVendor", fields: [vendor_id], references: [id])

  title   String   @db.VarChar(255)
  message String?  @db.Text
  files   String[]
  links   String[]

  @@map("booking_deliverables")
}

/**
 * ------------------------------------------------------------
 * --- Booking Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Review Schema start ---
 * -------------------------------------------------------------
 */

model Review {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  author_id String
  author    User   @relation("ReviewAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  vendor_id String
  vendor    User   @relation("ReviewVendor", fields: [vendor_id], references: [id], onDelete: Cascade)

  listing_id String?
  listing    VendorListing? @relation(fields: [listing_id], references: [id])

  booking_id String  @unique
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  rating  Int     @db.SmallInt
  comment String? @db.Text
  reply   String? @db.Text

  @@map("reviews")
}

/**
 * ------------------------------------------------------------
 * --- Review Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Event (Event Planner managed events) Schema start ---
 * -------------------------------------------------------------
 */

model Event {
  id         String      @id @default(cuid())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  event_planner_id String
  event_planner    User   @relation("EventPlannerEvents", fields: [event_planner_id], references: [id], onDelete: Cascade)

  name         String      @db.VarChar(255)
  type         EventType?
  date         DateTime?
  venue        String?     @db.VarChar(255)
  guest_count  Int?
  total_budget Decimal?    @db.Decimal(10, 2)
  status       EventStatus @default(PLANNING)
  notes        String?     @db.Text

  bookings     EventBooking[]
  budget_items BudgetItem[]
  tasks        EventTask[]

  @@map("events")
}

model EventBooking {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  event_id   String
  event      Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@unique([event_id, booking_id])
  @@map("event_bookings")
}

model BudgetItem {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  event_id  String
  event     Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  category  String  @db.VarChar(100)
  allocated Decimal @db.Decimal(10, 2)
  spent     Decimal @default(0) @db.Decimal(10, 2)
  note      String? @db.VarChar(255)

  @@map("budget_items")
}

model EventTask {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  event_id  String
  event     Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  title     String    @db.VarChar(255)
  due_date  DateTime?
  completed Boolean   @default(false)

  @@map("event_tasks")
}

/**
 * ------------------------------------------------------------
 * --- Event (Event Planner managed events) Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Event Planner Schema start ---
 * -------------------------------------------------------------
 */

model EventPlannerProfile {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user_id String @unique
  user    User   @relation("UserToEventPlannerProfile", fields: [user_id], references: [id], onDelete: Cascade)

  business_name String?  @db.VarChar(255)
  bio           String?  @db.Text
  website       String?  @db.VarChar(255)
  instagram     String?  @db.VarChar(255)
  portfolio     String[]
  event_types   EventType[]

  years_experience Int?
  team_size        Int?

  license_photo  String[]
  license_status ADMIN_APPROVE_STATUS @default(PENDING)
  approved_at    DateTime?

  @@map("event_planner_profiles")
}

/**
 * ------------------------------------------------------------
 * --- Event Planner Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Others Schema start ---
 * -------------------------------------------------------------
 */

model Faq {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status     Int?    @default(1) @db.SmallInt
  sort_order Int?    @default(0)
  question   String?
  answer     String?

  @@map("faqs")
}

model Contact {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  first_name   String?
  last_name    String?
  email        String?
  phone_number String?
  message      String?

  @@map("contacts")
}

/**
 * ------------------------------------------------------------
 * --- Others Schema end ---
 * -------------------------------------------------------------
 */


// ─── Contracts ──────────────────────────────────────────────────────────────

enum ContractCategory {
  GENERAL
  PHOTO_VIDEO
  RENTALS
  CATERING
  ENTERTAINMENT
  VENUE
  BEAUTY
}

enum ContractTemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum VendorContractType {
  DEFAULT
  UPLOADED
}

enum VendorContractStatus {
  ACTIVE
  ARCHIVED
  DISABLED
}

enum BookingContractStatus {
  DRAFT
  AWAITING_CUSTOMER
  AWAITING_VENDOR
  EXECUTED
  VOID
  SUPERSEDED
}

enum ContractSignerRole {
  CUSTOMER
  PLANNER
  VENDOR
}

enum ContractAuditAction {
  CREATED
  VIEWED
  SIGNED
  COUNTERSIGNED
  EXECUTED
  EMAILED
  DOWNLOADED
  VOIDED
  SUPERSEDED
  ADMIN_VIEWED
  VERIFIED
  VENDOR_CONTRACT_DISABLED
}

model ContractTemplate {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category        ContractCategory
  version         Int
  title           String                 @db.VarChar(255)
  // markdown-ish text with {{merge_field}} placeholders
  body            String                 @db.Text
  required_fields String[]
  status          ContractTemplateStatus @default(DRAFT)

  vendorContracts VendorContract[]

  @@unique([category, version])
  @@map("contract_templates")
}

model VendorContract {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vendor_id String
  vendor    User   @relation("VendorContractOwner", fields: [vendor_id], references: [id], onDelete: Restrict)

  type    VendorContractType
  version Int
  status  VendorContractStatus @default(ACTIVE)

  // DEFAULT: the exact template version used
  template_id String?
  template    ContractTemplate? @relation(fields: [template_id], references: [id], onDelete: Restrict)

  field_values     Json    @default("{}")
  additional_terms String? @db.Text

  // UPLOADED: private storage key + hash of the vendor's PDF
  file_key      String?
  file_sha256   String? @db.VarChar(64)
  file_name     String? @db.VarChar(255)
  ownership_confirmed_at DateTime?

  applies_to_all Boolean @default(true)
  listings       VendorContractListing[]

  disabled_reason String?   @db.Text
  disabled_at     DateTime?
  disabled_by_id  String?

  bookingContracts BookingContract[]

  @@unique([vendor_id, version])
  @@index([vendor_id, status])
  @@map("vendor_contracts")
}

model VendorContractListing {
  vendor_contract_id String
  vendor_contract    VendorContract @relation(fields: [vendor_contract_id], references: [id], onDelete: Cascade)
  listing_id         String
  listing            VendorListing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@id([vendor_contract_id, listing_id])
  @@map("vendor_contract_listings")
}

model BookingContract {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Restrict)

  vendor_contract_id String
  vendor_contract    VendorContract @relation(fields: [vendor_contract_id], references: [id], onDelete: Restrict)

  version Int
  status  BookingContractStatus @default(DRAFT)

  // frozen snapshot shown to signers
  title           String  @db.VarChar(255)
  rendered_body   String  @db.Text
  merge_data      Json
  // uploaded contracts: copy of the vendor PDF at the time of booking
  source_pdf_key    String?
  source_pdf_sha256 String? @db.VarChar(64)
  // hash of exactly what signers agreed to (rendered body + source PDF hash)
  content_sha256  String  @db.VarChar(64)

  executed_pdf_key    String?
  executed_pdf_sha256 String?   @db.VarChar(64)
  verification_code   String    @unique @db.VarChar(32)
  executed_at         DateTime?
  voided_at           DateTime?
  void_reason         String?   @db.Text
  last_reminder_at    DateTime?

  // an amendment points at the contract it would replace; declined amendments are voided
  supersedes_id String?
  supersedes    BookingContract?  @relation("ContractAmendment", fields: [supersedes_id], references: [id], onDelete: Restrict)
  amendments    BookingContract[] @relation("ContractAmendment")

  signatures  ContractSignature[]
  auditEvents ContractAuditEvent[]

  @@unique([booking_id, version])
  @@index([status])
  @@index([supersedes_id])
  @@map("booking_contracts")
}

model ContractSignature {
  id        String   @id @default(cuid())
  signed_at DateTime @default(now())

  booking_contract_id String
  booking_contract    BookingContract @relation(fields: [booking_contract_id], references: [id], onDelete: Restrict)

  user_id String?
  user    User?   @relation("ContractSigner", fields: [user_id], references: [id], onDelete: SetNull)

  role                 ContractSignerRole
  legal_name           String  @db.VarChar(255)
  signer_email         String? @db.VarChar(255)
  signature_image_key  String?
  consent_text_version String  @db.VarChar(32)
  ip_address           String? @db.VarChar(64)
  user_agent           String? @db.Text
  app_version          String? @db.VarChar(64)
  device_platform      String? @db.VarChar(64)
  document_sha256      String  @db.VarChar(64)

  @@unique([booking_contract_id, role])
  @@map("contract_signatures")
}

model ContractAuditEvent {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  booking_contract_id String?
  booking_contract    BookingContract? @relation(fields: [booking_contract_id], references: [id], onDelete: Restrict)
  vendor_contract_id  String?

  actor_id   String?
  actor      User?   @relation("ContractAuditActor", fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role String? @db.VarChar(32)

  action     ContractAuditAction
  ip_address String? @db.VarChar(64)
  user_agent String? @db.Text
  details    Json?

  @@index([booking_contract_id, created_at])
  @@map("contract_audit_events")
}

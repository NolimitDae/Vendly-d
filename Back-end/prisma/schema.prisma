generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------
 * --- Enum Start ---
 * -------------------------------------------------------------
 */

enum UserType {
  ADMIN
  CUSTOMER
  VENDOR
  EVENT_PLANNER
  PROVIDER
  EDITOR
  CLIENT
}

enum ADMIN_APPROVE_STATUS {
  PENDING
  APPROVED
  NOT_APPLICABLE
  SUSPENDED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  PENDING
}

enum WorkingType {
  DAY
  HOUR
}

enum OperatedBy {
  REMOTE
  ON_SITE
  HYBRID
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum SubscriptionBillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

// How a booking is paid: the vendor picks a preset per listing, snapshotted onto each booking.
enum PaymentPlan {
  FULL_ON_ACCEPT
  DEPOSIT_50
  DEPOSIT_25
  PAY_AFTER_SERVICE
}

enum InstallmentStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  CONCERT
  CONFERENCE
  PRIVATE_PARTY
  OTHER
}

enum EventStatus {
  PLANNING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/**
 * ------------------------------------------------------------
 * --- Enum End ---
 * -------------------------------------------------------------
 */

model Account {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type                String?
  provider            String?
  provider_account_id String?
  refresh_token       String?
  access_token        String?
  expires_at          DateTime?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?

  @@unique([provider, provider_account_id])
  @@map("accounts")
}

/**
 * ------------------------------------------------------------
 * --- user profile part start ---
 * -------------------------------------------------------------
 */

model User {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?
  status     Int?      @default(1) @db.SmallInt

  first_name   String? @db.VarChar(255)
  last_name    String? @db.VarChar(255)
  name         String? @db.VarChar(255)
  avatar       String?
  location     String? @db.VarChar(255)
  phone_number String?
  email        String? @unique
  password     String? @db.VarChar(255)
  birthday     String?

  about_me String?
  address  String?
  type     UserType? @default(CUSTOMER)
  // every role this login holds (one login, several roles); `type` is the one in use right now
  roles          UserType[] @default([])
  // set when an admin approves an ID check; switching or adding roles needs it
  id_verified_at DateTime?
  language String?   @db.VarChar(100)

  // billing info  
  billing_id        String?
  // stripe connect account
  stripe_connect_id String?
  //user balance
  balance           Decimal?  @default(0.0) @db.Decimal(10, 2)
  // expo push notifications
  push_token        String?
  // which optional emails and pushes the user wants ({ "booking_updates": true, ... }); null = all on
  notification_prefs Json?
  // Vendly's admins were told this vendor cancelled too many bookings (see booking/vendor-cancellations.ts)
  cancellations_alerted_at DateTime?
  // a demo account made in Admin -> Settings -> Test vendors: shown with a "Test" badge, never emailed or paid out
  is_test           Boolean   @default(false)
  // email verification
  email_verified_at DateTime?
  terms_accepted_at DateTime? // when they ticked Terms of Service + Privacy Policy at sign-up
  // onboarding popups already shown, per role: { "VENDOR": { "intro": "<iso>", "complete": "<iso>" } }
  onboarding_seen   Json      @default("{}")
  // subscription 

  //----------------------------------------
  bio           String?   @db.Text
  domain        String?   @unique
  username      String?   @unique
  country       String?
  state         String?
  city          String?
  zip_code      String?
  gender        String?
  date_of_birth DateTime? @db.Date
  approved_at   DateTime?
  availability  String?

  is_two_factor_enabled Int?      @default(0)
  two_factor_secret     String?
  accounts              Account[]

  // --- Vendor Profile ---
  vendorProfile VendorProfile? @relation("UserToVendorProfile")
  identityVerifications IdentityVerification[] @relation("IdentityVerificationUser")

  // --- Conversation & Messaging ---
  participants Participant[] @relation("participantUser")
  sentMessages Message[]     @relation("messageSender")

  // --- Notifications ---
  receivedNotifications Notification[] @relation("notificationReceiver")
  sentNotifications     Notification[] @relation("notificationSender")

  user_payment_methods UserPaymentMethod[]
  ucodes               Ucode[]
  role_users           RoleUser[]
  payment_transactions PaymentTransaction[]

  // Vendor listings
  vendorListings VendorListing[] @relation("VendorListingOwner")
  vendorAddOns   VendorAddOn[]   @relation("VendorAddOnOwner")
  blocksMade     UserBlock[]     @relation("BlocksMade")
  blocksReceived UserBlock[]     @relation("BlocksReceived")
  reportsMade    UserReport[]    @relation("ReportsMade")
  reportsAgainst UserReport[]    @relation("ReportsAgainst")
  rentalItems    RentalItem[]    @relation("RentalItemOwner")
  quotesSent     Quote[]         @relation("QuoteVendor")
  timelineItems  EventTimelineItem[] @relation("TimelineVendor")
  eventFiles     EventFile[]     @relation("EventFileUploader")
  vendorTeams    VendorTeam[]    @relation("PlannerTeams")
  quotesReceived Quote[]         @relation("QuoteCustomer")

  // Bookings as customer
  customerBookings Booking[] @relation("BookingCustomer")
  // Bookings as vendor
  vendorBookings Booking[] @relation("BookingVendor")
  // Proof uploads
  bookingProofs BookingProof[] @relation("ProofUploader")
  // Deliverables sent
  deliverables  BookingDeliverable[] @relation("DeliverableVendor")

  vendorContracts     VendorContract[]     @relation("VendorContractOwner")
  contractSignatures  ContractSignature[]  @relation("ContractSigner")
  contractAuditEvents ContractAuditEvent[] @relation("ContractAuditActor")
  // anonymised instead of deleted when the user is party to an executed contract
  anonymized_at       DateTime?

  // Events as planner
  plannedEvents Event[] @relation("EventPlannerEvents")

  // Reviews
  writtenReviews  Review[] @relation("ReviewAuthor")
  receivedReviews Review[] @relation("ReviewVendor")

  // Saved listings (favourites)
  savedListings SavedListing[] @relation("UserSavedListings")

  // Event planner profile
  eventPlannerProfile EventPlannerProfile? @relation("UserToEventPlannerProfile")

  // Calendar sync (vendor): private .ics feed + imported busy time
  calendarSync       CalendarSync?       @relation("CalendarSyncUser")
  calendarBusyBlocks CalendarBusyBlock[] @relation("CalendarBusyUser")

  @@map("users")
}

model VendorProfile {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String @unique
  user    User   @relation("UserToVendorProfile", fields: [user_id], references: [id], onDelete: Cascade)

  subscription_active Boolean              @default(false)
  // license
  license_photo       String[]
  license_status      ADMIN_APPROVE_STATUS @default(PENDING)
  approved_at         DateTime?

  // business info
  business_name           String?                  @db.VarChar(255)
  about_me                String?                  @db.Text
  address                 String?
  // shop page: vendlymarketplace.com/v/<handle>, plus banner and logo filenames (avatar storage dir)
  handle                  String?                  @unique @db.VarChar(30)
  banner                  String?
  logo                    String?
  vendorSubscriptionPlans VendorSubscriptionPlan[]
  // private storage key of the vendor's saved drawn signature
  saved_signature_key     String?
  // weekly hours customers can book, e.g. {"mon":{"open":"09:00","close":"17:00"},"sun":null}; null = not set (any day)
  working_hours           Json?
  // social accounts shown on the shop page, stored as full links (built from a handle or a pasted link)
  website                 String?                  @db.VarChar(255)
  instagram               String?                  @db.VarChar(255)
  tiktok                  String?                  @db.VarChar(255)
  facebook                String?                  @db.VarChar(255)
  youtube                 String?                  @db.VarChar(255)
  x                       String?                  @db.VarChar(255)
  // where customers come for packages done at the vendor's place: private, shown only to customers
  // with an accepted booking (booking/booking-tracker.ts); position geocoded in the background
  business_address        String?                  @db.VarChar(500)
  business_lat            Float?
  business_lng            Float?
  business_geocoded_at    DateTime?

  @@map("vendor_profiles")
}

model Ucode {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  status     Int?     @default(1) @db.SmallInt

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  token       String?
  email       String?
  expired_at  DateTime?
  verified_at DateTime?

  @@map("ucodes")
}

/**
 * ------------------------------------------------------------
 * --- user profile part end ---
 * -------------------------------------------------------------
 */
/**
 * ------------------------------------------------------------
 * --- Subscription part start ---
 * -------------------------------------------------------------
 */

model Subscriptionlist {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  name String

  billing_cycle           SubscriptionBillingCycle?
  status                  SubscriptionStatus?
  vendorSubscriptionPlans VendorSubscriptionPlan[]

  @@map("subscriptions")
}

model VendorSubscriptionPlan {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  vendor_id String
  vendor    VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  subscription_id String
  subscription    Subscriptionlist @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  start_date DateTime?
  end_date   DateTime?

  payment_status         SubscriptionPaymentStatus?
  stripe_subscription_id String?

  @@map("vendor_subscriptions")
}

/**
 * ------------------------------------------------------------
 * --- Subscription part end---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- service part start ---
 * -------------------------------------------------------------
 */

model Service {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name         String      @db.VarChar(255)
  operated_by  OperatedBy
  working_type WorkingType
  commission   Decimal     @default(0.0) @db.Decimal(5, 2)

  // Relationships  ক্যাটেগরি সম্পর্ক
  category_id String
  category    ServiceCategory @relation("ServiceCategoryRelation", fields: [category_id], references: [id])

  // Many-to-Many relationship with serviceToSubCategory
  sub_categories ServiceToSubCategory[] @relation("ServiceWithManyToMany")

  @@map("services")
}

model ServiceCategory {
  id         String   @id @default(cuid())
  name       String   @unique @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relationships with  service
  services       Service[]            @relation("ServiceCategoryRelation")
  default_payment_plan PaymentPlan?
  // overrides the platform Vendly Protection fee percent for this category
  fee_percent          Decimal?     @db.Decimal(5, 2)
  // Many-to-Many relationship with sub-categories
  sub_categories ServiceSubCategory[] @relation("ServiceCategoryToSubCategory")
  // Vendor listings
  vendor_listings VendorListing[]

  @@map("service_categories")
}

model ServiceSubCategory {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String @db.VarChar(255)

  // Parent Category link
  category_id String
  category    ServiceCategory @relation("ServiceCategoryToSubCategory", fields: [category_id], references: [id], onDelete: Cascade)

  // Many-to-Many join table link
  services ServiceToSubCategory[] @relation("Subcatagoryto-ServiceToSubCategory")
  // Vendor listings
  vendor_listings VendorListing[]

  @@unique([name, category_id])
  @@map("service_sub_categories")
}

// between Service and ServiceSubCategory
model ServiceToSubCategory {
  service_id      String
  sub_category_id String

  service      Service            @relation("ServiceWithManyToMany", fields: [service_id], references: [id], onDelete: Cascade)
  sub_category ServiceSubCategory @relation("Subcatagoryto-ServiceToSubCategory", fields: [sub_category_id], references: [id], onDelete: Cascade)

  @@id([service_id, sub_category_id])
  @@map("service_to_sub_categories")
}

/**
 * ------------------------------------------------------------
 * --- service part end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Chating Part Start ---
 * -------------------------------------------------------------
 */

model Conversation {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  participants Participant[]

  // group chats (event chats): a title and is_group; 1:1 chats leave these empty
  is_group          Boolean @default(false)
  title             String? @db.VarChar(255)
  event_id          String? @unique
  event             Event?  @relation(fields: [event_id], references: [id], onDelete: SetNull)
  pinned_message_id String?
  quotes            Quote[]
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("participantUser", fields: [userId], references: [id], onDelete: Cascade)

  role     String?  @default("participant")
  joinedAt DateTime @default(now())

  lastReadAt DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id        String   @id @default(cuid())
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status MessageStatus @default(PENDING)

  senderId String
  sender   User   @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  attachments String[] @db.Text

  // "text" | "quote" (a custom price card) | "system" (joined / pinned notices)
  kind     String  @default("text") @db.VarChar(20)
  quote_id String?
  quote    Quote?  @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  // a phone number or email was detected (shown to admins; never blocks the message)
  contact_flagged Boolean @default(false)

  @@index([conversationId])
  @@index([senderId])
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

/// A custom price a vendor offers in chat; accepting it starts a booking request at that price.
model Quote {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  vendor_id       String
  vendor          User         @relation("QuoteVendor", fields: [vendor_id], references: [id], onDelete: Cascade)
  // who the quote is for (the customer or planner in the chat)
  customer_id     String
  customer        User         @relation("QuoteCustomer", fields: [customer_id], references: [id], onDelete: Cascade)
  listing_id      String
  listing         VendorListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  event_id        String?

  title       String      @db.VarChar(255)
  description String?     @db.Text
  amount      Decimal     @db.Decimal(10, 2)
  expires_at  DateTime
  status      QuoteStatus @default(PENDING)
  booking_id  String?     @unique

  messages Message[]

  @@index([conversation_id])
  @@index([customer_id, status])
  @@map("quotes")
}

/**
 * ------------------------------------------------------------
 * --- Chating Part End ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Notification Part Start ---
 * -------------------------------------------------------------
 */

model NotificationEvent {
  id            String         @id @default(uuid())
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  deleted_at    DateTime?
  status        Int?           @default(1) @db.SmallInt
  type          String?
  text          String?
  notifications Notification[]
}

model Notification {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?
  read_at    DateTime?
  status     Int?      @default(1) @db.SmallInt

  sender_id String?
  sender    User?   @relation("notificationSender", fields: [sender_id], references: [id])

  receiver_id String?
  receiver    User?   @relation("notificationReceiver", fields: [receiver_id], references: [id])

  notification_event_id String?
  notification_event    NotificationEvent? @relation(fields: [notification_event_id], references: [id])

  entity_id String?

  @@index([receiver_id])
  @@index([sender_id])
  @@index([read_at])
}

/**
 * ------------------------------------------------------------
 * --- Notification Part End ---
 * -------------------------------------------------------------
 */
/**
 * ------------------------------------------------------------
 * --- Role and Permission Schema start ---
 * -------------------------------------------------------------
 */

model Role {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status Int?    @default(1) @db.SmallInt
  title  String?
  name   String?

  permission_roles PermissionRole[]
  role_users       RoleUser[]
  permissions      Permission[]     @relation("PermissionToRole")

  @@map("roles")
}

model Permission {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status     Int?    @default(1) @db.SmallInt
  title      String?
  action     String?
  subject    String?
  conditions String?
  fields     String?

  permission_roles PermissionRole[]
  roles            Role[]           @relation("PermissionToRole")

  @@map("permissions")
}

model PermissionRole {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([permission_id, role_id])
  @@map("permission_roles")
}

model RoleUser {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([role_id, user_id])
  @@map("role_users")
}

/**
 * ------------------------------------------------------------
 * --- Role and Permission Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Payment Schema start ---
 * -------------------------------------------------------------
 */

model UserPaymentMethod {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  payment_method_id String?
  checkout_id       String?

  @@map("user_payment_methods")
}

model PaymentTransaction {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  store_id String?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  order_id         String?
  type             String?  @default("order")
  withdraw_via     String?  @default("wallet")
  provider         String?
  reference_number String?
  status           String?  @default("pending")
  raw_status       String?
  amount           Decimal?
  currency         String?
  paid_amount      Decimal?
  paid_currency    String?

  @@map("payment_transactions")
}

/**
 * ------------------------------------------------------------
 * --- Payment Schema end ---
 * -------------------------------------------------------------
 */
/**
 * ------------------------------------------------------------
 * --- Vendor Listing Schema start ---
 * -------------------------------------------------------------
 */

model VendorListing {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  vendor_id String
  vendor    User   @relation("VendorListingOwner", fields: [vendor_id], references: [id], onDelete: Cascade)

  title       String        @db.VarChar(255)
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  price_unit  String        @default("fixed") @db.VarChar(50)
  status      ListingStatus @default(DRAFT)

  images        String[]
  tags          String[]
  location      String?   @db.VarChar(255)
  // map position of location (geocoded on save) for "near me" search
  lat           Float?
  lng           Float?
  // when geocoding last ran for this location; null = still to do
  geocoded_at   DateTime?
  // how far the vendor travels from `location` (miles); null = customers come to them / not set
  service_radius_miles Int?
  // where the service happens: CUSTOMER_LOCATION (the vendor goes to the venue) or VENDOR_LOCATION
  // (the customer comes to the vendor's business address)
  service_at    String    @default("CUSTOMER_LOCATION") @db.VarChar(20)
  availability  String?   @db.Text
  delivery_time Int?

  category_id    String?
  category       ServiceCategory?    @relation(fields: [category_id], references: [id])
  sub_category_id String?
  sub_category   ServiceSubCategory? @relation(fields: [sub_category_id], references: [id])

  // null = use the category default, else FULL_ON_ACCEPT
  payment_plan   PaymentPlan?
  // per person / hour / day packages: the fewest and most a customer can book (guests, hours or days)
  min_quantity   Int?
  max_quantity   Int?
  // what the package includes (shown as a list), and how far ahead it must be booked
  included_items   String[]
  min_notice_hours Int?

  bookings       Booking[]
  add_ons        ListingAddOn[]
  reviews        Review[]
  savedBy        SavedListing[]        @relation("ListingSavedBy")
  blockedDates   ListingAvailability[]
  contractAssignments VendorContractListing[]
  quotes         Quote[]

  @@index([lat, lng])
  @@map("vendor_listings")
}

model ListingAvailability {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  listing_id String
  listing    VendorListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  reason     String?  @db.VarChar(255)

  @@map("listing_availability")
}

/**
 * ------------------------------------------------------------
 * --- Vendor Listing Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Saved Listings (Favourites) ---
 * -------------------------------------------------------------
 */

model SavedListing {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  user_id String
  user    User   @relation("UserSavedListings", fields: [user_id], references: [id], onDelete: Cascade)

  listing_id String
  listing    VendorListing @relation("ListingSavedBy", fields: [listing_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id])
  @@map("saved_listings")
}

/**
 * ------------------------------------------------------------
 * --- Saved Listings end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Booking Schema start ---
 * -------------------------------------------------------------
 */

model Booking {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  customer_id String
  customer    User   @relation("BookingCustomer", fields: [customer_id], references: [id], onDelete: Cascade)

  vendor_id String
  vendor    User   @relation("BookingVendor", fields: [vendor_id], references: [id], onDelete: Cascade)

  listing_id String?
  listing    VendorListing? @relation(fields: [listing_id], references: [id])

  status        BookingStatus @default(PENDING)
  scheduled_at  DateTime?
  completed_at  DateTime?
  cancelled_at  DateTime?

  message        String?  @db.Text
  reject_reason  String?  @db.Text
  // the note written with a cancellation (older bookings: the only reason there is)
  cancel_reason  String?  @db.Text
  // who cancelled: CUSTOMER | VENDOR | SYSTEM (not paid in time) | ADMIN; the picked reason (booking/cancel-reasons.ts)
  cancelled_by       String?  @db.VarChar(20)
  cancel_reason_code String?  @db.VarChar(40)

  amount         Decimal? @db.Decimal(10, 2)
  currency       String?  @default("usd")
  // Vendly's customer service fee, fixed when the booking is requested
  service_fee    Decimal? @db.Decimal(10, 2)
  paid_at            DateTime?
  // vendor earnings credited to their payout balance (set once, on completion)
  payout_credited_at DateTime?

  payment_transaction_id String?

  // Phase B payment engine
  payment_plan       PaymentPlan?
  // Stripe PaymentMethod the customer chose when requesting; charged off-session on accept
  payment_method_id  String?
  // deposit plans: a missed deposit or balance must be paid by this time, or the booking is cancelled
  // (payments/payment-due.ts); deposit | balance; the customer was reminded when ~2 hours were left
  payment_due_by          DateTime?
  payment_due_kind        String?   @db.VarChar(20)
  payment_due_reminded_at DateTime?
  // booked under the deposit rules of Oct 2026 (12 hours to pay a missed charge, deposit non-refundable
  // when the customer cancels or doesn't pay); bookings made before keep the old rules
  deposit_rules           Boolean   @default(true)
  // when held funds may be released to the vendor (set on completion, pulled earlier by approval/proof)
  release_at         DateTime?
  released_at        DateTime?
  transfer_id        String?
  customer_approved_at DateTime?
  dispute_opened_at  DateTime?
  dispute_reason     String?   @db.Text
  dispute_resolved_at DateTime?
  dispute_resolution String?   @db.Text
  // the vendor's side of a customer's dispute, shown to Vendly
  dispute_vendor_reply      String?   @db.Text
  dispute_vendor_replied_at DateTime?
  // what the customer said the problem was and what they asked for (photos are private storage keys)
  dispute_category          String?   @db.VarChar(40)
  dispute_photos            String[]
  // full_refund | partial_refund | other
  dispute_outcome           String?   @db.VarChar(20)
  dispute_requested_amount  Decimal?  @db.Decimal(10, 2)
  // the final invoice (package, add-ons, fees, refunds, money back) was emailed
  invoice_sent_at           DateTime?
  // deposit paid out to the vendor before the job (recovered from later payouts if refunded)
  early_released_amount Decimal @default(0) @db.Decimal(10, 2)
  // Vendly commission taken from the vendor share at release
  commission_amount  Decimal?  @db.Decimal(10, 2)
  promo_code         String?   @db.VarChar(50)
  discount           Decimal?  @db.Decimal(10, 2)
  // reference photos the customer attached to the request (private storage keys)
  request_photos     String[]
  installments       BookingInstallment[]
  // rentals: refundable hold authorized before pickup, captured only for damage / late fees
  security_deposit   Decimal?  @db.Decimal(10, 2)
  rental_reservations RentalReservation[]
  rental_return      RentalReturn?

  event_start_at DateTime?
  event_end_at   DateTime?
  venue_address  String?  @db.VarChar(500)
  guest_count    Int?
  // venue_address on the map, geocoded in the background (null = not found or not done yet)
  venue_lat         Float?
  venue_lng         Float?
  venue_geocoded_at DateTime?
  // the tracker's times (booking/booking-tracker.ts): accepted, started, and the vendor's day-of steps.
  // They never change status or money; `status` stays the authority for that
  confirmed_at  DateTime?
  started_at    DateTime?
  en_route_at   DateTime?
  arrived_at    DateTime?
  checked_in_at DateTime?

  // requests the vendor doesn't answer in time are declined automatically (see booking-requests.ts);
  // the clock starts when the vendor can answer: at the request, or once a planner's client co-signs
  request_opened_at  DateTime?
  expiry_reminded_at DateTime?
  expired_at         DateTime?
  // "how was it?" follow-up once a booking is done
  review_reminded_at         DateTime?
  review_prompt_dismissed_at DateTime?

  // vendor price + the commission taken when it was paid out (refunds after payout are recovered net of commission)
  released_gross Decimal?  @db.Decimal(10, 2)
  // short lock while money moves on this booking (see withBookingLock); expires on its own after a crash
  money_lock_until DateTime?
  money_lock_token String?   @db.VarChar(64)

  review        Review?
  extras        BookingExtra[]
  contracts     BookingContract[]
  event_bookings EventBooking[]
  proofs        BookingProof[]
  deliverables  BookingDeliverable[]

  @@index([status, created_at])
  @@index([status, completed_at])
  @@index([payment_due_by])
  @@index([vendor_id, cancelled_at])
  @@map("bookings")
}

/// One scheduled charge of a booking's payment plan (deposit, balance, full amount).
model BookingInstallment {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  booking_id String
  booking    Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  sequence   Int
  label      String   @db.VarChar(100)
  amount     Decimal  @db.Decimal(10, 2)
  // portion of amount that is the Vendly Protection fee (never paid out to the vendor)
  fee_amount Decimal  @default(0) @db.Decimal(10, 2)
  currency   String   @default("usd")
  due_at     DateTime
  status     InstallmentStatus @default(SCHEDULED)
  // PAY_AFTER_SERVICE holds the authorization and captures on completion
  capture_manually Boolean @default(false)
  // "charge" (the price) | "security_deposit" (rental hold, never captured on completion) | "extra" (damage / late fees)
  kind             String  @default("charge") @db.VarChar(30)

  payment_intent_id String?
  attempts          Int       @default(0)
  next_attempt_at   DateTime?
  last_error        String?   @db.Text
  paid_at           DateTime?
  refunded_amount   Decimal   @default(0) @db.Decimal(10, 2)
  // when this installment's vendor share was paid out (with the booking, or later for extras paid after it)
  paid_out_at       DateTime?
  // the customer was emailed a receipt for this charge
  receipt_sent_at   DateTime?
  extra             BookingExtra?

  @@index([booking_id])
  @@index([status, next_attempt_at])
  @@map("booking_installments")
}

// ─── Chat safety ─────────────────────────────────────────────────────────────

/// One person blocking another: neither can message the other. Bookings carry on.
model UserBlock {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  blocker_id String
  blocker    User   @relation("BlocksMade", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_id String
  blocked    User   @relation("BlocksReceived", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocked_id])
  @@map("user_blocks")
}

/// Someone reported a person (optionally a conversation or one message) to Vendly.
model UserReport {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  reporter_id String
  reporter    User   @relation("ReportsMade", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported_id String
  reported    User   @relation("ReportsAgainst", fields: [reported_id], references: [id], onDelete: Cascade)

  conversation_id String?
  message_id      String?
  // a copy of the reported message, kept even if the sender deletes it
  message_text        String?  @db.Text
  message_attachments String[]
  // spam | harassment | scam | inappropriate | other
  reason          String  @db.VarChar(30)
  details         String? @db.Text
  // OPEN | ACTIONED | DISMISSED
  status          String  @default("OPEN") @db.VarChar(20)
  resolved_at     DateTime?
  resolved_by     String?
  resolution_note String?   @db.Text

  @@index([status, created_at])
  @@index([reported_id])
  @@map("user_reports")
}

// ─── Add-ons and fees ─────────────────────────────────────────────────────────

/// ADD_ON: something extra a customer can buy (at booking, or requested during the job).
/// FEE: a charge the vendor may request after the job (late return, cleaning, overtime), shown on the package up front.
enum AddOnKind {
  ADD_ON
  FEE
}

/// How an add-on's price is counted: once, per guest, per hour of the event, or per item the customer picks.
enum AddOnPriceUnit {
  FIXED
  PER_PERSON
  PER_HOUR
  PER_ITEM
}

enum BookingExtraStatus {
  // chosen when booking; part of the booking price and contract
  INCLUDED
  // requested by the vendor after booking; waiting for the customer
  PENDING
  // customer (or Vendly) approved; charged as an installment
  APPROVED
  DECLINED
  // withdrawn by the vendor, or the booking ended first
  CANCELLED
  // a declined or unanswered fee sent to Vendly to decide
  IN_REVIEW
  // Vendly decided the customer doesn't pay
  WAIVED
}

/// A vendor's add-on or fee. Library items are reused across packages; custom ones belong to one package.
model VendorAddOn {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  vendor_id String
  vendor    User   @relation("VendorAddOnOwner", fields: [vendor_id], references: [id], onDelete: Cascade)

  kind         AddOnKind      @default(ADD_ON)
  name         String         @db.VarChar(120)
  description  String?        @db.VarChar(500)
  price        Decimal        @db.Decimal(10, 2)
  price_unit   AddOnPriceUnit @default(FIXED)
  // PER_ITEM: the most a customer can pick
  max_quantity Int?
  // false = made inside one package's form; it isn't offered for other packages
  in_library   Boolean        @default(true)

  listings ListingAddOn[]
  extras   BookingExtra[]

  @@index([vendor_id, kind])
  @@map("vendor_add_ons")
}

model ListingAddOn {
  created_at DateTime @default(now())

  listing_id String
  listing    VendorListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  add_on_id  String
  add_on     VendorAddOn   @relation(fields: [add_on_id], references: [id], onDelete: Cascade)
  sort       Int           @default(0)

  @@id([listing_id, add_on_id])
  @@index([add_on_id])
  @@map("listing_add_ons")
}

/// An add-on or fee on one booking, with its name and price frozen when it was added.
model BookingExtra {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  booking_id String
  booking    Booking      @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  add_on_id  String?
  add_on     VendorAddOn? @relation(fields: [add_on_id], references: [id], onDelete: SetNull)

  kind        AddOnKind
  name        String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  unit_price  Decimal        @db.Decimal(10, 2)
  price_unit  AddOnPriceUnit @default(FIXED)
  quantity    Decimal        @default(1) @db.Decimal(10, 2)
  // vendor price: unit_price x quantity
  amount      Decimal        @db.Decimal(10, 2)
  // Vendly Protection fee the customer pays on top (add-ons requested after booking; never on fees)
  fee_amount  Decimal        @default(0) @db.Decimal(10, 2)
  // the vendor's reason or details, e.g. "Returned 3 hours late"
  note        String?        @db.Text
  // extra time this adds to the booking (moves its end time when approved)
  extends_minutes Int?
  status      BookingExtraStatus

  responded_at   DateTime?
  decline_reason String?   @db.Text
  reminded_at    DateTime?
  review_requested_at DateTime?
  review_note    String?   @db.Text
  reviewed_at    DateTime?
  reviewed_by    String?

  installment_id String?             @unique
  installment    BookingInstallment? @relation(fields: [installment_id], references: [id], onDelete: SetNull)

  @@index([booking_id])
  @@index([status, created_at])
  @@map("booking_extras")
}

// ─── Rentals (Phase D) ───────────────────────────────────────────────────────

enum RentalItemStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum RentalReservationStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

model RentalItem {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  vendor_id String
  vendor    User   @relation("RentalItemOwner", fields: [vendor_id], references: [id], onDelete: Cascade)

  title            String           @db.VarChar(255)
  description      String           @db.Text
  images           String[]
  category_id      String?
  daily_rate       Decimal          @db.Decimal(10, 2)
  // refundable security deposit per unit
  deposit_amount   Decimal          @default(0) @db.Decimal(10, 2)
  quantity         Int              @default(1)
  // cleaning / delivery buffer either side of a rental during which the stock is unavailable
  turnaround_hours Int              @default(24)
  location         String?          @db.VarChar(255)
  status           RentalItemStatus @default(DRAFT)

  reservations RentalReservation[]

  @@index([vendor_id])
  @@index([status])
  @@map("rental_items")
}

model RentalReservation {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  item_id    String
  item       RentalItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  booking_id String
  booking    Booking    @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  start_date DateTime
  end_date   DateTime
  quantity   Int
  daily_rate Decimal  @db.Decimal(10, 2)
  status     RentalReservationStatus @default(ACTIVE)

  @@index([item_id, start_date, end_date])
  @@index([booking_id])
  @@map("rental_reservations")
}

model RentalReturn {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  booking_id      String  @unique
  booking         Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  photos          String[]
  notes           String? @db.Text
  damage_reported Boolean @default(false)
  damage_fee      Decimal @default(0) @db.Decimal(10, 2)
  late_fee        Decimal @default(0) @db.Decimal(10, 2)
  recorded_by     String

  @@map("rental_returns")
}

model BookingProof {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  uploader_id String
  uploader    User   @relation("ProofUploader", fields: [uploader_id], references: [id])

  photos      String[]
  notes       String?  @db.Text

  @@map("booking_proofs")
}

model BookingDeliverable {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  vendor_id String
  vendor    User   @relation("DeliverableVendor", fields: [vendor_id], references: [id])

  title   String   @db.VarChar(255)
  message String?  @db.Text
  files   String[]
  links   String[]

  @@map("booking_deliverables")
}

/**
 * ------------------------------------------------------------
 * --- Booking Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Review Schema start ---
 * -------------------------------------------------------------
 */

model Review {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  author_id String
  author    User   @relation("ReviewAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  vendor_id String
  vendor    User   @relation("ReviewVendor", fields: [vendor_id], references: [id], onDelete: Cascade)

  listing_id String?
  listing    VendorListing? @relation(fields: [listing_id], references: [id])

  booking_id String  @unique
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  rating  Int     @db.SmallInt
  comment String? @db.Text
  reply   String? @db.Text

  @@map("reviews")
}

/**
 * ------------------------------------------------------------
 * --- Review Schema end ---
 * -------------------------------------------------------------
 */

/**
 * ------------------------------------------------------------
 * --- Event (Event Planner managed events) Schema start ---
 * -------------------------------------------------------------
 */

model Event {
  id         String      @id @default(cuid())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  event_planner_id String
  event_planner    User   @relation("EventPlannerEvents", fields: [event_planner_id], references: [id], onDelete: Cascade)

  name         String      @db.VarChar(255)
  type         EventType?
  date         DateTime?
  venue        String?     @db.VarChar(255)
  guest_count  Int?
  total_budget Decimal?    @db.Decimal(10, 2)
  status       EventStatus @default(PLANNING)
  notes        String?     @db.Text
  completed_at DateTime?
  cancelled_at DateTime?

  bookings     EventBooking[]
  budget_items BudgetItem[]
  tasks        EventTask[]
  conversation Conversation?
  timeline     EventTimelineItem[]
  files        EventFile[]

  // the planner's client: read-only access matched by email (works before they sign up)
  client_email     String?  @db.VarChar(255)
  client_invited_at DateTime?
  // whether the client sees costs (vendor prices, budget)
  client_sees_budget Boolean @default(false)

  @@index([client_email])
  @@map("events")
}

model EventBooking {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  event_id   String
  event      Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@unique([event_id, booking_id])
  @@map("event_bookings")
}

model BudgetItem {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  event_id  String
  event     Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  category  String  @db.VarChar(100)
  allocated Decimal @db.Decimal(10, 2)
  spent     Decimal @default(0) @db.Decimal(10, 2)
  note      String? @db.VarChar(255)
  // a line backed by a real booking: spent follows what has been paid on it
  booking_id String? @unique

  @@map("budget_items")
}

/// Run of show: what happens when on the day, optionally owned by a booked vendor.
model EventTimelineItem {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  event_id  String
  event     Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  starts_at DateTime
  ends_at   DateTime?
  title     String    @db.VarChar(255)
  notes     String?   @db.Text
  location  String?   @db.VarChar(255)
  vendor_id String?
  vendor    User?     @relation("TimelineVendor", fields: [vendor_id], references: [id], onDelete: SetNull)
  done      Boolean   @default(false)

  @@index([event_id, starts_at])
  @@map("event_timeline_items")
}

/// Files shared on an event (floor plans, shot lists, menus). Stored privately; downloaded through signed links.
model EventFile {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  event_id    String
  event       Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  key         String  @db.VarChar(500)
  name        String  @db.VarChar(255)
  size        Int
  mime        String  @db.VarChar(120)
  uploaded_by String
  uploader    User    @relation("EventFileUploader", fields: [uploaded_by], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@map("event_files")
}

/// A planner's saved group of vendors they like to work with.
model VendorTeam {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  planner_id String
  planner    User     @relation("PlannerTeams", fields: [planner_id], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(120)
  vendor_ids String[]

  @@index([planner_id])
  @@map("vendor_teams")
}

model EventTask {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  event_id  String
  event     Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)

  title     String    @db.VarChar(255)
  due_date  DateTime?
  completed Boolean   @default(false)

  @@map("event_tasks")
}

/**
 * ------------------------------------------------------------
 * --- Event (Event Planner managed events) Schema end ---
 * -------------------------------------------------------------
 */


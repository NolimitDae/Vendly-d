// ─── Contracts ──────────────────────────────────────────────────────────────

enum ContractCategory {
  GENERAL
  PHOTO_VIDEO
  RENTALS
  CATERING
  ENTERTAINMENT
  VENUE
  BEAUTY
}

enum ContractTemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum VendorContractType {
  DEFAULT
  UPLOADED
}

enum VendorContractStatus {
  ACTIVE
  ARCHIVED
  DISABLED
}

enum BookingContractStatus {
  DRAFT
  AWAITING_CUSTOMER
  // planner bookings with client co-signing on: the client signs before the vendor
  AWAITING_CLIENT
  AWAITING_VENDOR
  EXECUTED
  VOID
  SUPERSEDED
}

enum ContractSignerRole {
  CUSTOMER
  PLANNER
  VENDOR
  // the planner's client co-signing (feature flag client_cosign)
  CLIENT
}

enum ContractAuditAction {
  CREATED
  VIEWED
  SIGNED
  COUNTERSIGNED
  EXECUTED
  EMAILED
  DOWNLOADED
  VOIDED
  SUPERSEDED
  ADMIN_VIEWED
  VERIFIED
  VENDOR_CONTRACT_DISABLED
}

model ContractTemplate {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category        ContractCategory
  version         Int
  title           String                 @db.VarChar(255)
  // markdown-ish text with {{merge_field}} placeholders
  body            String                 @db.Text
  required_fields String[]
  status          ContractTemplateStatus @default(DRAFT)

  vendorContracts VendorContract[]

  @@unique([category, version])
  @@map("contract_templates")
}

model VendorContract {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vendor_id String
  vendor    User   @relation("VendorContractOwner", fields: [vendor_id], references: [id], onDelete: Restrict)

  type    VendorContractType
  version Int
  status  VendorContractStatus @default(ACTIVE)

  // DEFAULT: the exact template version used
  template_id String?
  template    ContractTemplate? @relation(fields: [template_id], references: [id], onDelete: Restrict)

  field_values     Json    @default("{}")
  additional_terms String? @db.Text

  // UPLOADED: private storage key + hash of the vendor's PDF
  file_key      String?
  file_sha256   String? @db.VarChar(64)
  file_name     String? @db.VarChar(255)
  ownership_confirmed_at DateTime?

  applies_to_all Boolean @default(true)
  listings       VendorContractListing[]
  // also applies to every package in these categories (including ones added later)
  category_ids   String[]

  disabled_reason String?   @db.Text
  disabled_at     DateTime?
  disabled_by_id  String?

  bookingContracts BookingContract[]

  @@unique([vendor_id, version])
  @@index([vendor_id, status])
  @@map("vendor_contracts")
}

model VendorContractListing {
  vendor_contract_id String
  vendor_contract    VendorContract @relation(fields: [vendor_contract_id], references: [id], onDelete: Cascade)
  listing_id         String
  listing            VendorListing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@id([vendor_contract_id, listing_id])
  @@map("vendor_contract_listings")
}

model BookingContract {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Restrict)

  vendor_contract_id String
  vendor_contract    VendorContract @relation(fields: [vendor_contract_id], references: [id], onDelete: Restrict)

  version Int
  status  BookingContractStatus @default(DRAFT)

  // frozen snapshot shown to signers
  title           String  @db.VarChar(255)
  rendered_body   String  @db.Text
  merge_data      Json
  // uploaded contracts: copy of the vendor PDF at the time of booking
  source_pdf_key    String?
  source_pdf_sha256 String? @db.VarChar(64)
  // hash of exactly what signers agreed to (rendered body + source PDF hash)
  content_sha256  String  @db.VarChar(64)

  executed_pdf_key    String?
  executed_pdf_sha256 String?   @db.VarChar(64)
  verification_code   String    @unique @db.VarChar(32)
  // the planner's client asked to co-sign (matched to their login by email)
  client_email        String?   @db.VarChar(255)
  executed_at         DateTime?
  voided_at           DateTime?
  void_reason         String?   @db.Text
  last_reminder_at    DateTime?

  // an amendment points at the contract it would replace; declined amendments are voided
  supersedes_id String?
  supersedes    BookingContract?  @relation("ContractAmendment", fields: [supersedes_id], references: [id], onDelete: Restrict)
  amendments    BookingContract[] @relation("ContractAmendment")

  signatures  ContractSignature[]
  auditEvents ContractAuditEvent[]

  @@unique([booking_id, version])
  @@index([status])
  @@index([supersedes_id])
  @@map("booking_contracts")
}

model ContractSignature {
  id        String   @id @default(cuid())
  signed_at DateTime @default(now())

  booking_contract_id String
  booking_contract    BookingContract @relation(fields: [booking_contract_id], references: [id], onDelete: Restrict)

  user_id String?
  user    User?   @relation("ContractSigner", fields: [user_id], references: [id], onDelete: SetNull)

  role                 ContractSignerRole
  legal_name           String  @db.VarChar(255)
  signer_email         String? @db.VarChar(255)
  signature_image_key  String?
  consent_text_version String  @db.VarChar(32)
  ip_address           String? @db.VarChar(64)
  user_agent           String? @db.Text
  app_version          String? @db.VarChar(64)
  device_platform      String? @db.VarChar(64)
  document_sha256      String  @db.VarChar(64)

  @@unique([booking_contract_id, role])
  @@map("contract_signatures")
}

model ContractAuditEvent {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  booking_contract_id String?
  booking_contract    BookingContract? @relation(fields: [booking_contract_id], references: [id], onDelete: Restrict)
  vendor_contract_id  String?

  actor_id   String?
  actor      User?   @relation("ContractAuditActor", fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role String? @db.VarChar(32)

  action     ContractAuditAction
  ip_address String? @db.VarChar(64)
  user_agent String? @db.Text
  details    Json?

  @@index([booking_contract_id, created_at])
  @@map("contract_audit_events")
}

/// Admin-editable platform settings (fees, currency, limits). Values are strings; callers parse.
model PlatformSetting {
  key        String   @id @db.VarChar(100)
  value      String   @db.Text
  updated_at DateTime @updatedAt

  @@map("platform_settings")
}

model PromoCode {
  id          String    @id @default(cuid())
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  code        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  // exactly one of percent_off / amount_off
  percent_off Decimal?  @db.Decimal(5, 2)
  amount_off  Decimal?  @db.Decimal(10, 2)
  min_amount  Decimal?  @db.Decimal(10, 2)
  max_uses    Int?
  uses        Int       @default(0)
  expires_at  DateTime?
  active      Boolean   @default(true)
  // each customer can use it once; only on a customer's first booking
  once_per_customer  Boolean @default(false)
  first_booking_only Boolean @default(false)

  @@map("promo_codes")
}

model FeatureFlag {
  key         String   @id @db.VarChar(100)
  enabled     Boolean  @default(false)
  description String?  @db.VarChar(255)
  updated_at  DateTime @updatedAt

  @@map("feature_flags")
}

// ─── ID verification (needed to switch or add account roles) ───────────────

enum IdentityVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model IdentityVerification {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_id String
  user    User   @relation("IdentityVerificationUser", fields: [user_id], references: [id], onDelete: Cascade)

  status        IdentityVerificationStatus @default(PENDING)
  // DRIVERS_LICENSE, PASSPORT, NATIONAL_ID or STATE_ID
  document_type String                     @db.VarChar(32)
  legal_name    String                     @db.VarChar(255)

  // private storage keys; served to admins only through short-lived signed links
  front_key  String
  back_key   String?
  selfie_key String

  reviewed_by_id   String?
  reviewed_at      DateTime?
  rejection_reason String?   @db.Text

  @@index([status, created_at])
  @@index([user_id])
  @@map("identity_verifications")
}

// ─── Calendar sync (vendor) ─────────────────────────────────────────────────

/// One per vendor: the secret token of their .ics feed and the calendar they import busy time from.
model CalendarSync {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_id String @unique
  user    User   @relation("CalendarSyncUser", fields: [user_id], references: [id], onDelete: Cascade)

  // random 32-byte secret in the feed URL (/api/calendar/feed/<token>.ics); regenerating replaces it
  feed_token String? @unique @db.VarChar(64)

  // their Google / Apple iCal address (itself a secret, never shown back in full)
  import_url           String?   @db.Text
  last_synced_at       DateTime?
  last_sync_error      String?   @db.Text
  last_sync_attempt_at DateTime?

  @@map("calendar_syncs")
}

/// Busy time imported from the vendor's own calendar. Replaced wholesale on every sync; manual blocks live in ListingAvailability.
model CalendarBusyBlock {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  user_id String
  user    User   @relation("CalendarBusyUser", fields: [user_id], references: [id], onDelete: Cascade)

  start_at   DateTime
  end_at     DateTime
  // the days it covers in the event's own time zone (inclusive); this is what blocks bookings
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  all_day    Boolean  @default(false)

  @@index([user_id, end_date])
  @@map("calendar_busy_blocks")
}

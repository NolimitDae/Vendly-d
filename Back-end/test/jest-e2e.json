{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^prisma/(.*)$": "<rootDir>/../prisma/$1"
  },
  "globalSetup": "<rootDir>/e2e-databases.ts",
  "setupFiles": [
    "<rootDir>/e2e-worker-db.ts"
  ]
}

# Backend API URL — must point to your deployed API server
NEXT_PUBLIC_API_ENDPOINT=https://your-api-domain.com

# WebSocket URL for real-time notifications and chat (usually same host as API)
NEXT_PUBLIC_SOCKET_URL=https://your-api-domain.com

# App base URL (used for redirects, OG meta, etc.)
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.com

# Optional: Stripe publishable key (if using Stripe Elements on the frontend)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Custom domain the uploaded images are served from (R2), if you use one; lets the site's image optimiser load them
# NEXT_PUBLIC_MEDIA_URL=https://media.yourdomain.com

# Error tracking (Sentry). Leave empty to turn it off.
NEXT_PUBLIC_SENTRY_DSN=
